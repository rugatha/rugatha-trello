rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function lookupPath(w) {
      return /databases/$(database)/documents/workspaces/$(w)/memberLookup/$(request.auth.token.email.lower());
    }
    function memberId(w) { return get(lookupPath(w)).data.memberId; }
    function memberPath(w) {
      return /databases/$(database)/documents/workspaces/$(w)/members/$(memberId(w));
    }
    function member(w) { return get(memberPath(w)).data; }
    function active(w) {
      return verified() && exists(lookupPath(w)) && exists(memberPath(w))
        && member(w).status == 'active';
    }
    function boardAccess(w, b) {
      return active(w) && b in member(w).accessboard;
    }
    function canEdit(w, b) {
      return boardAccess(w, b) && member(w).role in ['admin', 'owner', 'editor']
        && exists(/databases/$(database)/documents/workspaces/$(w)/boards/$(b))
        && !get(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)).data.get('deleting', false);
    }
    function isAdmin(w, b) {
      return boardAccess(w, b) && member(w).role in ['admin', 'owner'];
    }
    function validDeadlineParts(data) {
      let p = data.get('dueParts', {});
      return p is map && p.keys().hasOnly(['year','month','day','period','hour','minute'])
        && p.get('year', '') is string && p.get('year', '').matches('[0-9]{0,4}')
        && p.get('month', '') is string && p.get('month', '').matches('[0-9]{0,2}')
        && p.get('day', '') is string && p.get('day', '').matches('[0-9]{0,2}')
        && p.get('hour', '') is string && p.get('hour', '').matches('[0-9]{0,2}')
        && p.get('minute', '') is string && p.get('minute', '').matches('[0-9]{0,2}')
        && p.get('period', '') in ['', 'AM', 'PM'];
    }
    match /workspaces/{w} {
      allow get: if active(w);
      allow list, write: if false;
      match /memberLookup/{email} {
        allow get: if verified() && email == request.auth.token.email.lower();
        allow list, write: if false;
      }
      match /members/{id}/notifications/{notificationId} {
        allow read: if active(w) && id == memberId(w);
        allow update: if active(w) && id == memberId(w)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
      match /members/{id} {
        allow get: if active(w) && id == memberId(w);
        allow list: if false;
        allow update: if active(w) && id == memberId(w)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'theme', 'avatar', 'boardOrder'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.get('theme', 'light') in ['light', 'dark']
          && request.resource.data.get('avatar', '') is string
          && request.resource.data.get('avatar', '').size() <= 50000
          && (request.resource.data.get('avatar', '') == ''
            || request.resource.data.avatar.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'))
          && request.resource.data.get('boardOrder', []) is list
          && request.resource.data.get('boardOrder', []).size() <= 500
          && request.resource.data.get('boardOrder', []).toSet().size() == request.resource.data.get('boardOrder', []).size()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['boardOrder'])
            || request.resource.data.boardOrder.toSet().hasOnly(resource.data.accessboard));
        allow create, delete: if false;
      }
      match /boards/{b} {
        allow get: if boardAccess(w, b);
        allow list: if false;
        function validBoard() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80;
        }
        function validColor() {
          return request.resource.data.get('color', '#455f56') in
            ['#455f56', '#c8b58f', '#8fa697', '#bca582', '#ad9790'];
        }
        function validMemberLabelEdit() {
          let before = resource.data.get('labelDefinitions', {});
          let after = request.resource.data.labelDefinitions;
          let changed = after.diff(before).affectedKeys();
          let key = request.resource.data.labelEditId;
          let label = after[key];
          return boardAccess(w, b) && !member(w).get('readOnly', false) && !resource.data.get('archived', false) && !resource.data.get('deleting', false)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['labelDefinitions','labelEditId'])
            && after is map && after.size() <= 200 && changed.size() == 1 && changed.hasOnly([key])
            && key is string && key.matches('[A-Za-z0-9_-]{1,128}') && label is map
            && label.diff(before.get(key, {})).affectedKeys().hasOnly(['name','color'])
            && label.name is string && label.name.size() > 0 && label.name.size() <= 40
            && label.color is string && label.color.matches('#[0-9a-fA-F]{6}');
        }
        allow update: if validMemberLabelEdit();
        allow create: if false;
        allow update: if canEdit(w, b) && validBoard()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived']) || member(w).role == 'admin')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['color']) || validColor());
        allow delete: if false;
        match /columns/{columnId} {
          allow read: if boardAccess(w, b);
          allow create, update: if canEdit(w, b)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 50;
          allow delete: if canEdit(w, b) && isAdmin(w, b);
        }
        match /cards/{cardId} {
          function mutableCard() {
            // Child documents can be created together with their parent card.
            return getAfter(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)/cards/$(cardId)).data != null
              && !getAfter(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)/cards/$(cardId)).data.get('deleting', false);
          }
          function validChecklistGroups() {
            let groups = request.resource.data.get('checklistGroups', []);
            return groups is list && groups.size() <= 50 && groups.toSet().size() == groups.size();
          }
          function assignedDeadlineEdit() {
            return boardAccess(w, b) && !member(w).get('readOnly', false)
              && memberId(w) in resource.data.get('assigneeIds', [])
              && !resource.data.get('archived', false) && !resource.data.get('deleting', false)
              && !get(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)).data.get('archived', false)
              && !get(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)).data.get('deleting', false)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['due', 'dueParts', 'updatedAt', 'updatedBy'])
              && validDeadlineParts(request.resource.data) && request.resource.data.due is string
              && (request.resource.data.due == '' || request.resource.data.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[+]08:00'))
              && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 64
              && request.resource.data.updatedBy == memberId(w);
          }
          allow update: if assignedDeadlineEdit();
          allow read: if boardAccess(w, b);
          allow create: if canEdit(w, b)
            && !request.resource.data.keys().hasAny(['deleting'])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 150
            && request.resource.data.createdBy == memberId(w)
            && request.resource.data.get('assigneeIds', []) in [[], [memberId(w)]] && validChecklistGroups() && validDeadlineParts(request.resource.data);
          allow update: if canEdit(w, b) && mutableCard()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleting'])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 150
            && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
            && request.resource.data.updatedBy == memberId(w)
            && validDeadlineParts(request.resource.data)
            && request.resource.data.get('assigneeIds', []) == resource.data.get('assigneeIds', [])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['checklistGroups'])
              || (isAdmin(w, b) && validChecklistGroups()));
          allow delete: if false;
          match /comments/{commentId} {
            allow read: if boardAccess(w, b);
            allow create: if canEdit(w, b) && mutableCard()
              && request.resource.data.memberId == memberId(w)
              && request.resource.data.get('mentions', []) == []
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000;
            allow update: if canEdit(w, b) && mutableCard()
              && resource.data.memberId == memberId(w)
              && request.resource.data.memberId == resource.data.memberId
              && request.resource.data.get('mentions', []) == resource.data.get('mentions', [])
              && (resource.data.get('mentions', []) == [] || request.resource.data.text == resource.data.text)
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 5000;
            allow delete: if canEdit(w, b) && mutableCard()
              && resource.data.memberId == memberId(w);
          }
          match /checklist/{itemId} {
            allow read: if boardAccess(w, b);
            function validChecklistSchedule() {
              // Trello imports store an unset deadline as null; treat it as empty.
              let storedDue = request.resource.data.get('due', '');
              let due = storedDue == null ? '' : storedDue;
              let assignee = request.resource.data.get('assigneeId', '');
              let parent = getAfter(/databases/$(database)/documents/workspaces/$(w)/boards/$(b)/cards/$(cardId)).data;
              return validDeadlineParts(request.resource.data) && due is string
                && (due == '' || due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00[+]08:00'))
                && assignee is string && (assignee == '' || assignee in parent.get('assigneeIds', []));
            }
            allow create, update: if canEdit(w, b) && mutableCard() && validChecklistSchedule();
            allow delete: if canEdit(w, b) && mutableCard();
          }
          match /attachments/{attachmentId} {
            allow read: if boardAccess(w, b);
            allow create, delete: if false;
            allow update: if canEdit(w, b) && mutableCard()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'updatedBy']);
          }
        }
      }
    }
  }
}
