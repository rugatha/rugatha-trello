{
  "name": "rugatha-trello",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rugatha-trello \"node --test tests/rules/*.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project demo-rugatha-trello \"node --test tests/storage-rules/*.test.mjs\"",
    "test:management": "firebase emulators:exec --only auth,firestore,functions --project demo-rugatha-trello \"node --test tests/management/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
