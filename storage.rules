rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function membership(w) {
      let id = firestore.get(/databases/(default)/documents/workspaces/$(w)/memberLookup/$(request.auth.token.email.lower())).data.memberId;
      let data = firestore.get(/databases/(default)/documents/workspaces/$(w)/members/$(id)).data;
      return {'id': id, 'data': data};
    }
    function access(w, b) {
      let m = membership(w).data;
      return verified() && m.status == 'active' && b in m.accessboard;
    }
    function uploadAccess(u, b) {
      let m = membership('main');
      return verified() && m.id == u && m.data.status == 'active'
        && b in m.data.accessboard && m.data.role in ['owner', 'admin', 'editor'];
    }
    match /workspaces/{w}/boards/{b}/cards/{c}/attachments/{a}/{filename} {
      // Archive is reversible: authorized members retain access to archived files.
      allow get: if access(w, b);
      allow list: if false;
      allow create, update, delete: if false;
    }
    // Temporary uploads are never readable; only trusted completion publishes them.
    match /uploads/{u}/{b}/{c}/{session}/{filename} {
      allow read, update, delete: if false;
      allow create: if resource == null && uploadAccess(u, b)
        && request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/gif',
          'image/webp', 'image/avif', 'application/pdf', 'text/plain',
          'application/zip', 'model/gltf-binary', 'model/stl']
        && request.resource.metadata.keys().hasOnly(['uploadedBy', 'boardId', 'cardId', 'attachmentId'])
        && request.resource.metadata.uploadedBy == u
        && request.resource.metadata.boardId == b
        && request.resource.metadata.cardId == c
        && request.resource.metadata.attachmentId == 'upload-' + session;
    }
  }
}
